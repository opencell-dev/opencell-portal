# /etc/opencell/portal.env on the portal guest (root:root 0600). The SMTP
# settings live in /etc/opencell/portal-smtp.env (SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_TOKEN), copied from the laptop; neither file is in git.
# OC_VERSION is not set here: oc-portal-deploy writes it into each release's
# .version.env, loaded by oc-portal.service as an optional EnvironmentFile.
NODE_ENV=production
PORT=3000
OC_LISTEN=0.0.0.0
OC_ORIGIN=https://opencell.k4ozi.com
OC_RP_ID=opencell.k4ozi.com
OC_SECRET=<openssl rand -hex 32>
OC_DB_PATH=/var/lib/oc-portal/portal.db
OC_CORE=fake
OC_MAIL=smtp
OC_MAIL_FROM=OpenCell <opencell@k4ozi.com>
OC_TRUSTED_PROXY=<nginx-proxy's address on internal>

# Optional tuning (each has a built-in default; uncomment to override).
# OC_MAIL_OUTBOX=./data/outbox      # only read when OC_MAIL=outbox
# OC_ALTCHA_COST=2000
# OC_ALTCHA_COUNTER_MAX=2000
