# /etc/opencell/portal.env on the portal guest (root:root 0600). The SMTP
# settings live in /etc/opencell/portal-smtp.env (SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_TOKEN), copied from the laptop; neither file is in git.
# OC_VERSION is not set here: oc-portal-deploy writes it into each release's
# .version.env, loaded by oc-portal.service as an optional EnvironmentFile.
NODE_ENV=production
# The subscriber portal (the default). The NOC is on its own site and guest
# (noc.env.example, NOC design §N1.5).
OC_SITE=portal
# Anubis (deploy/anubis/) answers nginx-proxy on :3000 and forwards to the
# portal here, on loopback only. oc-portal-deploy health-checks this PORT.
PORT=3001
OC_LISTEN=127.0.0.1
OC_ORIGIN=https://opencell.k4ozi.com
OC_RP_ID=opencell.k4ozi.com
OC_SECRET=<openssl rand -hex 32>
OC_DB_PATH=/var/lib/oc-portal/portal.db
# The cores' admin API (portal spec §7), plan P4b: OC_CORES lists the cores
# in order, each with its address and the name its certificate carries.
# Every number and subscriber operation goes to the first (core1) until P5
# routes each block to its home core; the admin dashboard shows them all.
# core1 is oc-core-1 on `internal`; core2 is oc-core-2 on the WireGuard link
# between the cores (10.99.0.0/24), reached through oc-core-1 (the route:
# deploy/oc-cores-route.service). One core only: OC_CORE_ADDR and
# OC_CORE_NAME instead of OC_CORES (it is then core1).
# The three files are shared by every core (one OpenCell root, the same
# portal certificate pinned on each); they come in as systemd credentials by
# name (the drop-in deploy/oc-portal-core-tls.conf maps them from
# /etc/opencell/tls/). OC_CORE=fake runs the in-process fake core instead
# (development).
OC_CORE=tls
OC_CORES=core1,core2
OC_CORE_CORE1_ADDR=10.0.0.60:7444
OC_CORE_CORE1_NAME=core1.opencell.k4ozi.com
OC_CORE_CORE2_ADDR=10.99.0.2:7444
OC_CORE_CORE2_NAME=core2.opencell.k4ozi.com
OC_CORE_CA=core-ca.crt
OC_CORE_CERT=core-client.crt
OC_CORE_KEY=core-client.key
OC_MAIL=smtp
OC_MAIL_FROM=OpenCell <opencell@k4ozi.com>
# The one peer whose X-Forwarded-For the portal believes: Anubis, which
# connects from 127.0.0.1 and passes on the client address nginx-proxy gave it
# (flattened to that one address). Before Anubis this was nginx-proxy's
# address on internal (10.0.0.100).
OC_TRUSTED_PROXY=127.0.0.1

# Optional tuning (each has a built-in default; uncomment to override).
# OC_MAIL_OUTBOX=./data/outbox      # only read when OC_MAIL=outbox
# OC_ALTCHA_COST=2000
# OC_ALTCHA_COUNTER_MAX=2000
