#!/bin/bash
# Deploy the portal to its guest (network-core spec §17.4): tags only, built
# on the target, the previous build kept for rollback.
#   deploy/oc-portal-deploy deploy vX.Y.Z
#   deploy/oc-portal-deploy rollback
#   deploy/oc-portal-deploy status
# OC_PORTAL_SSH overrides how to reach the guest (default: through the
# Proxmox host as jump host).
set -euo pipefail
SSH="${OC_PORTAL_SSH:-ssh -o BatchMode=yes -J root@147.135.11.61:222 root@10.0.0.61}"
KEEP=3

usage() {
  echo "usage: oc-portal-deploy deploy vX.Y.Z | rollback | status" >&2
  exit 2
}

remote() { $SSH "bash -s" -- "$@"; }

# Runs on the guest: switch `current` to a release, restart, wait for health.
SWITCH='
switch_to() {
  local target="$1" want="$2"
  local prev; prev="$(readlink /opt/oc-portal/current || true)"
  ln -sfn "$target" /opt/oc-portal/current.new && mv -T /opt/oc-portal/current.new /opt/oc-portal/current
  [ -n "$prev" ] && [ "$prev" != "$target" ] && echo "$prev" > /opt/oc-portal/previous
  systemctl restart oc-portal
  for _ in $(seq 1 30); do
    if curl -fsS http://127.0.0.1:3000/healthz 2>/dev/null | grep -q "\"version\":\"$want\""; then
      echo "healthy: $want"; return 0
    fi
    sleep 1
  done
  echo "not healthy after 30 s: $want" >&2
  if [ -n "$prev" ] && [ "$prev" != "$target" ]; then
    ln -sfn "$prev" /opt/oc-portal/current.new && mv -T /opt/oc-portal/current.new /opt/oc-portal/current
    systemctl restart oc-portal
    echo "rolled back to $prev" >&2
  fi
  return 1
}
'

cmd="${1:-}"
case "$cmd" in
  deploy)
    tag="${2:-}"
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "only tags vX.Y.Z are deployed (got '${tag}')" >&2; exit 2; }
    git rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "no tag $tag in this repository" >&2; exit 2; }
    echo "sending $tag"
    git archive --format=tar --prefix="$tag/" "$tag" | $SSH "rm -rf /opt/oc-portal/releases/$tag.tmp && mkdir -p /opt/oc-portal/releases/$tag.tmp && tar -x -C /opt/oc-portal/releases/$tag.tmp"
    remote "$tag" "$KEEP" <<REMOTE
set -euo pipefail
$SWITCH
tag="\$1"; keep="\$2"
rel=/opt/oc-portal/releases/\$tag
rm -rf "\$rel" && mv "\$rel.tmp/\$tag" "\$rel" && rmdir "\$rel.tmp"
echo "OC_VERSION=\$tag" > "\$rel/.version.env"
chown -R oc-portal:oc-portal "\$rel"
cd "\$rel"
runuser -u oc-portal -- env HOME=/var/lib/oc-portal npm ci --no-audit --no-fund
runuser -u oc-portal -- env HOME=/var/lib/oc-portal NODE_ENV=production npx next build
if [ -f /var/lib/oc-portal/portal.db ]; then
  runuser -u oc-portal -- sqlite3 /var/lib/oc-portal/portal.db ".backup '/var/lib/oc-portal/backups/pre-\$tag-\$(date -u +%Y%m%dT%H%M%SZ).db'"
fi
switch_to "\$rel" "\$tag"
cd /opt/oc-portal/releases
cur="\$(basename "\$(readlink /opt/oc-portal/current)")"
prev="\$(basename "\$(cat /opt/oc-portal/previous 2>/dev/null || echo none)")"
ls -1t | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | grep -vx -e "\$cur" -e "\$prev" | tail -n +\$((keep - 1)) | xargs -r rm -rf
REMOTE
    ;;
  rollback)
    [ $# -eq 1 ] || usage
    remote <<REMOTE
set -euo pipefail
$SWITCH
prev="\$(cat /opt/oc-portal/previous 2>/dev/null || true)"
[ -n "\$prev" ] && [ -d "\$prev" ] || { echo "no previous build to roll back to" >&2; exit 1; }
switch_to "\$prev" "\$(basename "\$prev")"
REMOTE
    ;;
  status)
    [ $# -eq 1 ] || usage
    remote <<'REMOTE'
echo "current:  $(readlink /opt/oc-portal/current || echo none)"
echo "previous: $(cat /opt/oc-portal/previous 2>/dev/null || echo none)"
echo "service:  $(systemctl is-active oc-portal)"
echo "health:   $(curl -fsS http://127.0.0.1:3000/healthz 2>/dev/null || echo down)"
REMOTE
    ;;
  *) usage ;;
esac
