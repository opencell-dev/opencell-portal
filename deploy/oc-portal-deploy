#!/bin/bash
# Deploy the portal to its guest (network-core spec §17.4): tags only, built
# on the target, the previous build kept for rollback.
#   deploy/oc-portal-deploy deploy vX.Y.Z
#   deploy/oc-portal-deploy rollback
#   deploy/oc-portal-deploy status
# OC_PORTAL_SSH overrides how to reach the guest (default: through the
# Proxmox host as jump host). OC_PORTAL_ROOT is a guest-side-only override
# (read by the remote script, never set here): tests use it to point every
# absolute path below at a scratch tree instead of the real guest; it is
# unset in production, so the paths below are the real absolute ones.
#
# A dropped SSH session must not leave a broken release live: over a non-pty
# `ssh ... bash -s`, sshd simply closes the pipes on disconnect (it does not
# send SIGHUP), so the first write to the now-closed stdout/stderr would
# kill the remote bash with SIGPIPE mid health-check, before its own
# rollback can run. So the remote script redirects its own stdout/stderr to
# a local log on the guest (var/log/oc-portal-deploy.log, 0600) before doing
# anything else, and ignores HUP and PIPE besides -- it no longer depends on
# the SSH pipe at all once past that line, so it runs to completion
# (including any rollback) regardless of what happens to the connection.
#
# Each run is tagged with an id; it records its log between "=== run <id>
# start" / "=== run <id> end" markers, its exit status in
# var/lib/oc-portal-deploy/status/<id> (a root-owned directory, never one
# the oc-portal service user can write to or symlink-swap -- see
# assert_safe_dir below), and its own id as the "latest run" marker. While
# the connection is up, the local side streams this run's log live
# (stream_log); after the ssh call returns, if its own exit code doesn't
# look like a real remote status (anything other than 0 or 1 -- ssh's own
# connection-error codes, conventionally 255), it polls the status file for
# up to OC_PORTAL_DEPLOY_POLL_BUDGET seconds (default 900 = 15 minutes, long
# enough to cover a normal build and health-check window) before giving up
# and pointing the operator at `oc-portal-deploy status` -- never at
# re-running the command, which for `rollback` would reverse a rollback
# that in fact already succeeded.
#
# Restoring across a schema migration: `rollback` only swaps `current` back
# to the previous release's code and takes a DB backup first — it does not
# reverse a schema migration the release being rolled back from may have
# applied. To recover pre-migration state: stop oc-portal, copy the matching
# backups/pre-<tag>-<timestamp>.db (taken just before that tag's migration
# ran, or backups/pre-rollback-<tag>-<timestamp>.db taken by the rollback
# itself) over portal.db, then start oc-portal on the rolled-back release.
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
SSH="${OC_PORTAL_SSH:-ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -J root@147.135.11.61:222 root@10.0.0.61}"
KEEP=3

usage() {
  echo "usage: oc-portal-deploy deploy vX.Y.Z | rollback | status" >&2
  exit 2
}

remote() { $SSH "bash -s" -- "$@"; }

# Streams this run's guest-side log live to our own stdout while the main
# call is in flight: polls (once a second, via `command -p sleep` so a
# test's faked `sleep` -- used to make the *guest-side* health-check loop
# instant -- can't affect this) for this run's slice of the log, printing
# only newly-appeared lines, until it sees the run's own end marker or the
# caller drops a stop-flag file (once the main call has returned; a run
# that was refused before ever writing a start marker would otherwise wait
# forever for an end marker that will never come). Every ssh call this
# makes is a quick, one-shot fetch (bounded by the default $SSH's own
# ConnectTimeout) -- there is no long-lived remote process to track or
# kill, so a slow or refused run can never make this hang the caller.
stream_log() { # run_id stop_flag
  local run_id="$1" stop_flag="$2" shown=0 total_output total
  while :; do
    total_output="$($SSH "ROOT=\"\${OC_PORTAL_ROOT:-}\"; sed -n \"/^=== run $run_id start/,/^=== run $run_id end/p\" \"\$ROOT/var/log/oc-portal-deploy.log\" 2>/dev/null" 2>/dev/null || true)"
    if [ -n "$total_output" ]; then
      total="$(printf '%s\n' "$total_output" | wc -l)"
      if [ "$total" -gt "$shown" ]; then
        printf '%s\n' "$total_output" | tail -n "+$((shown + 1))"
        shown="$total"
      fi
      case "$total_output" in
        *"=== run $run_id end"*) return 0 ;;
      esac
    fi
    [ -f "$stop_flag" ] && return 0
    command -p sleep 1
  done
}

# Polls the guest's recorded status for a run, for up to a wall-clock budget
# (OC_PORTAL_DEPLOY_POLL_BUDGET seconds, default 900) -- long enough for a
# normal deploy to finish building and health-checking. `command -p sleep`
# bypasses PATH, so a test's faked `sleep` (used to make the *guest-side*
# health-check loop instant) can never shrink *this* budget.
wait_for_status() { # run_id
  local run_id="$1"
  local budget="${OC_PORTAL_DEPLOY_POLL_BUDGET:-900}"
  local interval="${OC_PORTAL_DEPLOY_POLL_INTERVAL:-5}"
  local deadline=$(( $(date +%s) + budget ))
  local s
  while [ "$(date +%s)" -lt "$deadline" ]; do
    s="$($SSH "ROOT=\"\${OC_PORTAL_ROOT:-}\"; cat \"\$ROOT/var/lib/oc-portal-deploy/status/$run_id\" 2>/dev/null" 2>/dev/null || true)"
    if [ -n "$s" ]; then printf '%s' "$s"; return 0; fi
    command -p sleep "$interval"
  done
  return 1
}

# Resolves the real exit status: ssh's own is trusted if it looks like one
# of ours (0 or 1); anything else (typically 255, ssh's own "the connection
# failed") means we don't actually know yet, since the remote script keeps
# running independently of the dropped connection -- so this fetches
# whatever of the log made it through, then polls for the guest's own
# recorded result rather than guessing, and if that times out, says so
# plainly instead of suggesting the operator re-run anything (re-running
# `rollback` after an unconfirmed rollback would reverse a rollback that in
# fact already succeeded).
finish_run() { # run_id ssh_rc
  local run_id="$1" rc="$2" status
  case "$rc" in
    0|1) return "$rc" ;;
  esac
  echo "ssh exited $rc (the connection may have dropped); the run keeps going on the guest independently -- checking its recorded status for $run_id" >&2
  $SSH "ROOT=\"\${OC_PORTAL_ROOT:-}\"; sed -n \"/^=== run $run_id start/,/^=== run $run_id end/p\" \"\$ROOT/var/log/oc-portal-deploy.log\" 2>/dev/null" || true
  if status="$(wait_for_status "$run_id")"; then
    echo "guest recorded exit $status for run $run_id" >&2
    return "$status"
  fi
  echo "no status recorded yet for run $run_id after waiting -- it may still be running; run 'oc-portal-deploy status' to check (do not just re-run deploy or rollback)" >&2
  return 1
}

# Refuses to use a directory that isn't exactly what bootstrap created: not
# a symlink (a service-user-writable directory upstream of it could have
# been swapped for one, pointing anywhere), must already exist (bootstrap's
# job, not this script's -- so there is nothing here for a compromised
# service user to race to create first), and owned by whoever is running
# this (root, in production; the invoking user in a test). Applied to the
# deploy-status tree and the log directory, per-run, before touching either.
ASSERT_SAFE_DIR='
assert_safe_dir() {
  local d="$1"
  if [ -L "$d" ]; then
    echo "refusing: $d is a symlink" >&2
    exit 1
  fi
  if [ ! -d "$d" ]; then
    echo "refusing: $d does not exist (bootstrap must create it first)" >&2
    exit 1
  fi
  local owner; owner="$(stat -c %u "$d" 2>/dev/null || echo -1)"
  if [ "$owner" != "$(id -u)" ]; then
    echo "refusing: $d is not owned by the user running this ($owner != $(id -u))" >&2
    exit 1
  fi
}
'

# Runs on the guest: switch `current` to a release, restart, wait for health.
# `previous` is only written once the new release is confirmed healthy, so a
# failed switch (which restores the old `current`) never leaves `previous`
# collapsed onto the same release as `current`.
SWITCH='
switch_to() {
  local target="$1" want="$2"
  local prev; prev="$(readlink "$ROOT/opt/oc-portal/current" || true)"
  ln -sfn "$target" "$ROOT/opt/oc-portal/current.new" && mv -T "$ROOT/opt/oc-portal/current.new" "$ROOT/opt/oc-portal/current"
  systemctl restart oc-portal || true
  for _ in $(seq 1 30); do
    if curl -fsS --max-time 5 http://127.0.0.1:3000/healthz 2>/dev/null | grep -q "\"version\":\"$want\""; then
      [ -n "$prev" ] && [ "$prev" != "$target" ] && echo "$prev" > "$ROOT/opt/oc-portal/previous"
      echo "healthy: $want"; return 0
    fi
    sleep 1
  done
  echo "not healthy after 30 s: $want"
  if [ -n "$prev" ] && [ "$prev" != "$target" ]; then
    ln -sfn "$prev" "$ROOT/opt/oc-portal/current.new" && mv -T "$ROOT/opt/oc-portal/current.new" "$ROOT/opt/oc-portal/current"
    systemctl restart oc-portal || true
    echo "rolled back to $prev"
  fi
  return 1
}
'

cmd="${1:-}"
case "$cmd" in
  deploy)
    tag="${2:-}"
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "only tags vX.Y.Z are deployed (got '${tag}')" >&2; exit 2; }
    git -C "$REPO" rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "no tag $tag in this repository" >&2; exit 2; }
    echo "sending $tag"
    git -C "$REPO" archive --format=tar --prefix="$tag/" "refs/tags/$tag" | $SSH "ROOT=\"\${OC_PORTAL_ROOT:-}\"; rm -rf \"\$ROOT/opt/oc-portal/releases/$tag.tmp\" && mkdir -p \"\$ROOT/opt/oc-portal/releases/$tag.tmp\" && tar -x -C \"\$ROOT/opt/oc-portal/releases/$tag.tmp\""
    run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    stop_flag="$(mktemp -u)"
    stream_log "$run_id" "$stop_flag" &
    tail_job=$!
    trap 'touch "$stop_flag" 2>/dev/null || true; wait "$tail_job" 2>/dev/null || true; rm -f "$stop_flag" 2>/dev/null || true' EXIT
    set +e
    remote "$run_id" "$tag" "$KEEP" <<REMOTE
main() {
set -euo pipefail
trap '' HUP PIPE
ROOT="\${OC_PORTAL_ROOT:-}"
runid="\$1"; tag="\$2"; keep="\$3"
rel="\$ROOT/opt/oc-portal/releases/\$tag"
DEPLOY_STATE_DIR="\$ROOT/var/lib/oc-portal-deploy"
STATUS_DIR="\$DEPLOY_STATE_DIR/status"
LOG="\$ROOT/var/log/oc-portal-deploy.log"
# Safety-net for the tar extraction already uploaded before this ran: if
# any assert_safe_dir below refuses, this still cleans it up (record_status
# below replaces this trap once past the point where that matters anyway).
trap 'rm -rf "\$rel.tmp" 2>/dev/null' EXIT
$ASSERT_SAFE_DIR
assert_safe_dir "\$DEPLOY_STATE_DIR"
assert_safe_dir "\$STATUS_DIR"
assert_safe_dir "\$ROOT/var/log"
assert_safe_dir "\$ROOT/run"
: >> "\$LOG"; chmod 0600 "\$LOG"
echo "\$runid" > "\$DEPLOY_STATE_DIR/latest-run-id"
exec 9>"\$ROOT/run/oc-portal-deploy.lock"
exec >>"\$LOG" 2>&1
echo "=== run \$runid start \$(date -u +%Y-%m-%dT%H:%M:%SZ) deploy \$tag ==="
record_status() {
  local rc="\$?"
  rm -rf "\${build:-}" 2>/dev/null || true
  echo "\$rc" > "\$STATUS_DIR/\$runid" 2>/dev/null || true
  echo "=== run \$runid end \$(date -u +%Y-%m-%dT%H:%M:%SZ) rc=\$rc ==="
}
trap record_status EXIT
if ! flock -n 9; then
  echo "another deploy/rollback is in progress"
  rm -rf "\$rel.tmp"
  exit 1
fi
$SWITCH
build="\$ROOT/opt/oc-portal/releases/.build-\$tag-\$\$"
cur="\$(basename "\$(readlink "\$ROOT/opt/oc-portal/current" 2>/dev/null || true)")"
prev_tag="\$(basename "\$(cat "\$ROOT/opt/oc-portal/previous" 2>/dev/null || true)")"
if [ "\$tag" = "\$cur" ]; then
  echo "refusing: \$tag is already the running release (current)"
  rm -rf "\$rel.tmp"
  exit 1
fi
if [ "\$tag" = "\$prev_tag" ]; then
  echo "refusing: \$tag is the previous (rollback) release; use 'oc-portal-deploy rollback' instead of redeploying it"
  rm -rf "\$rel.tmp"
  exit 1
fi
rm -rf "\$build" && mv "\$rel.tmp/\$tag" "\$build" && rmdir "\$rel.tmp"
echo "OC_VERSION=\$tag" > "\$build/.version.env"
chown -R oc-portal:oc-portal "\$build"
(
  cd "\$build" || exit 1
  runuser -u oc-portal -- env HOME=/var/lib/oc-portal npm ci --no-audit --no-fund
  runuser -u oc-portal -- env HOME=/var/lib/oc-portal NODE_ENV=production npx next build
)
# Only now, with a built release in hand, touch the live path: a failed
# build above (set -e) leaves current and previous completely alone, and
# redeploying either of those two tags was already refused above.
rm -rf "\$rel"
mv -T "\$build" "\$rel"
if [ -f "\$ROOT/var/lib/oc-portal/portal.db" ]; then
  runuser -u oc-portal -- sqlite3 "\$ROOT/var/lib/oc-portal/portal.db" ".backup '\$ROOT/var/lib/oc-portal/backups/pre-\$tag-\$(date -u +%Y%m%dT%H%M%SZ).db'"
  find "\$ROOT/var/lib/oc-portal/backups" -maxdepth 1 -type f -name 'pre-*.db' -printf '%T@ %p\n' 2>/dev/null | sort -rn | tail -n +11 | cut -d' ' -f2- | xargs -r rm -f
fi
switch_to "\$rel" "\$tag"
cd "\$ROOT/opt/oc-portal/releases" || exit 1
cur="\$(basename "\$(readlink "\$ROOT/opt/oc-portal/current")")"
prev="\$(basename "\$(cat "\$ROOT/opt/oc-portal/previous" 2>/dev/null || echo none)")"
mapfile -t all_releases < <(ls -1t | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+\$' || true)
old=()
for r in "\${all_releases[@]}"; do
  [ "\$r" = "\$cur" ] && continue
  [ "\$r" = "\$prev" ] && continue
  [ "\$r" = "\$tag" ] && continue
  old+=("\$r")
done
if [ "\${#old[@]}" -gt \$((keep - 2)) ]; then
  printf '%s\n' "\${old[@]:\$((keep - 2))}" | xargs -r rm -rf
fi
# A run killed before its own EXIT trap could clean up leaves a stale build
# scratch dir behind; sweep anything older than an hour. Status files are
# tiny but accumulate one per deploy/rollback forever otherwise; keep 30
# days. Neither failure should abort an otherwise-successful deploy.
find "\$ROOT/opt/oc-portal/releases" -maxdepth 1 -name '.build-*' -mmin +60 -exec rm -rf {} + || true
find "\$STATUS_DIR" -maxdepth 1 -type f -mtime +30 -delete || true
}
main "\$@"
REMOTE
    rc=$?
    set -e
    set +e
    finish_run "$run_id" "$rc"
    frc=$?
    set -e
    exit "$frc"
    ;;
  rollback)
    [ $# -eq 1 ] || usage
    run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    stop_flag="$(mktemp -u)"
    stream_log "$run_id" "$stop_flag" &
    tail_job=$!
    trap 'touch "$stop_flag" 2>/dev/null || true; wait "$tail_job" 2>/dev/null || true; rm -f "$stop_flag" 2>/dev/null || true' EXIT
    set +e
    remote "$run_id" <<REMOTE
main() {
set -euo pipefail
trap '' HUP PIPE
ROOT="\${OC_PORTAL_ROOT:-}"
runid="\$1"
DEPLOY_STATE_DIR="\$ROOT/var/lib/oc-portal-deploy"
STATUS_DIR="\$DEPLOY_STATE_DIR/status"
LOG="\$ROOT/var/log/oc-portal-deploy.log"
$ASSERT_SAFE_DIR
assert_safe_dir "\$DEPLOY_STATE_DIR"
assert_safe_dir "\$STATUS_DIR"
assert_safe_dir "\$ROOT/var/log"
assert_safe_dir "\$ROOT/run"
: >> "\$LOG"; chmod 0600 "\$LOG"
echo "\$runid" > "\$DEPLOY_STATE_DIR/latest-run-id"
exec 9>"\$ROOT/run/oc-portal-deploy.lock"
exec >>"\$LOG" 2>&1
echo "=== run \$runid start \$(date -u +%Y-%m-%dT%H:%M:%SZ) rollback ==="
record_status() {
  local rc="\$?"
  echo "\$rc" > "\$STATUS_DIR/\$runid" 2>/dev/null || true
  echo "=== run \$runid end \$(date -u +%Y-%m-%dT%H:%M:%SZ) rc=\$rc ==="
}
trap record_status EXIT
if ! flock -n 9; then
  echo "another deploy/rollback is in progress"
  exit 1
fi
$SWITCH
prev="\$(cat "\$ROOT/opt/oc-portal/previous" 2>/dev/null || true)"
[ -n "\$prev" ] && [ -d "\$prev" ] || { echo "no previous build to roll back to"; exit 1; }
target_tag="\$(basename "\$prev")"
if [ -f "\$ROOT/var/lib/oc-portal/portal.db" ]; then
  runuser -u oc-portal -- sqlite3 "\$ROOT/var/lib/oc-portal/portal.db" ".backup '\$ROOT/var/lib/oc-portal/backups/pre-rollback-\$target_tag-\$(date -u +%Y%m%dT%H%M%SZ).db'"
fi
switch_to "\$prev" "\$target_tag"
find "\$STATUS_DIR" -maxdepth 1 -type f -mtime +30 -delete || true
}
main "\$@"
REMOTE
    rc=$?
    set -e
    set +e
    finish_run "$run_id" "$rc"
    frc=$?
    set -e
    exit "$frc"
    ;;
  status)
    [ $# -eq 1 ] || usage
    remote <<'REMOTE'
main() {
ROOT="${OC_PORTAL_ROOT:-}"
DEPLOY_STATE_DIR="$ROOT/var/lib/oc-portal-deploy"
STATUS_DIR="$DEPLOY_STATE_DIR/status"
LOG="$ROOT/var/log/oc-portal-deploy.log"
LOCKFILE="$ROOT/run/oc-portal-deploy.lock"
assert_safe_dir() {
  local d="$1"
  if [ -L "$d" ]; then echo "refusing: $d is a symlink" >&2; exit 1; fi
  if [ ! -d "$d" ]; then echo "refusing: $d does not exist (bootstrap must create it first)" >&2; exit 1; fi
  local owner; owner="$(stat -c %u "$d" 2>/dev/null || echo -1)"
  if [ "$owner" != "$(id -u)" ]; then echo "refusing: $d is not owned by the user running this ($owner != $(id -u))" >&2; exit 1; fi
}
assert_safe_dir "$DEPLOY_STATE_DIR"
assert_safe_dir "$STATUS_DIR"
assert_safe_dir "$ROOT/var/log"
assert_safe_dir "$ROOT/run"
echo "current:  $(readlink "$ROOT/opt/oc-portal/current" || echo none)"
echo "previous: $(cat "$ROOT/opt/oc-portal/previous" 2>/dev/null || echo none)"
echo "service:  $(systemctl is-active oc-portal)"
echo "health:   $(curl -fsS --max-time 5 http://127.0.0.1:3000/healthz 2>/dev/null || echo down)"
latest_id="$(cat "$DEPLOY_STATE_DIR/latest-run-id" 2>/dev/null || true)"
if [ -z "$latest_id" ]; then
  echo "latest run: none"
else
  if [ -f "$STATUS_DIR/$latest_id" ]; then
    result="exit $(cat "$STATUS_DIR/$latest_id")"
  elif flock -n "$LOCKFILE" -c true 2>/dev/null; then
    result="no recorded status (interrupted before it could finish)"
  else
    result="in progress"
  fi
  echo "latest run: $latest_id ($result)"
  echo "--- tail of run $latest_id's log ---"
  sed -n "/^=== run $latest_id start/,/^=== run $latest_id end/p" "$LOG" 2>/dev/null | tail -n 40
fi
}
main
REMOTE
    ;;
  *) usage ;;
esac
