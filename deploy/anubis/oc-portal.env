# /etc/anubis/oc-portal.env on the portal guest (root:root 0644; nothing
# secret): the settings of anubis@oc-portal.service, the Anubis instance in
# front of the portal. install-anubis.sh installs it from here; the signing
# key lives apart, in /etc/anubis/oc-portal.key.env (0600, made on the guest).
# Every variable: docs/docs/admin/installation.mdx in the Anubis repository.
#
#   nginx-proxy (10.0.0.100) --> :3000 Anubis --> 127.0.0.1:3001 the portal

# All addresses, like the portal before it; nftables lets only nginx-proxy
# reach 3000 from outside the guest.
BIND=:3000
BIND_NETWORK=tcp
# An IPv4 literal, not "localhost": the portal believes X-Forwarded-For only
# from OC_TRUSTED_PROXY=127.0.0.1, and a connection from ::1 is not that.
TARGET=http://127.0.0.1:3001
POLICY_FNAME=/etc/anubis/oc-portal.botPolicies.yaml
# Prometheus metrics and Anubis's own /healthz, on loopback only.
METRICS_BIND=127.0.0.1:9090
METRICS_BIND_NETWORK=tcp

# Anubis's default robots.txt: every known AI crawler, then everyone, disallowed.
SERVE_ROBOTS_TXT=true

# The pass cookie. Host-wide on the portal's name, HTTPS only, not readable
# by page scripts (Anubis's own scripts never read it). SameSite=Lax, like
# the portal's session cookie: sent on a top-level navigation from another
# site (the link in a mail client) and on the portal's own fetches and form
# posts; there is no cross-site embedding to need None. Not partitioned: the
# portal is never in a frame (it sends frame-ancestors 'none').
COOKIE_DOMAIN=opencell.k4ozi.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_PARTITIONED=false
COOKIE_HTTP_ONLY=true
COOKIE_PREFIX=oc-anubis
COOKIE_EXPIRATION_TIME=168h
# Where a solved challenge may send the browser back to.
REDIRECT_DOMAINS=opencell.k4ozi.com

# Client addresses. nginx-proxy (NPM) sets X-Real-IP to the address it saw
# ($remote_addr). For X-Forwarded-For its stock proxy.conf appends that
# address to whatever the client sent ($proxy_add_x_forwarded_for); the
# portal's proxy host instead sends just $remote_addr, by replacing NPM's
# default location with deploy/anubis/npm-proxy-host.advanced.conf (or,
# where headers-more is loaded, `more_clear_input_headers X-Forwarded-For;`
# in its advanced config) — see README.md, "Client addresses".
# Anubis reads X-Real-IP; toward the portal it flattens X-Forwarded-For to
# the right-most address that is not private, loopback, CGNAT or link-local
# (so nginx-proxy's own 10.0.0.100 never counts), and the portal reads only
# that. A pass is only good from the address that earned it.
XFF_STRIP_PRIVATE=true
JWT_RESTRICTION_HEADER=X-Real-IP

# The difficulty for anything the policy leaves unset (the policy sets its own).
DIFFICULTY=4
