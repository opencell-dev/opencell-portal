# The Anubis release in front of the portal (https://github.com/TecharoHQ/anubis,
# MIT). install-anubis.sh installs exactly this .deb and refuses anything else;
# tests/helpers/anubis.ts runs the matching linux-amd64 tarball.
#
# Pinned 2026-09-30 from the v1.27.0 release (2026-08-08): both SHA-256s match
# the digests GitHub lists for the release assets, and each file's .asc
# verifies with the key in techaro-packages.asc ("Techaro Packages
# Signatures <gpg+packages@techaro.lol>", ed25519, published on the
# maintainer's GitHub account: https://github.com/Xe.gpg). To move to a new
# release: download the .deb, the tarball and their .asc, check them the same
# way, and update all four lines together.
ANUBIS_VERSION=1.27.0
ANUBIS_DEB_SHA256_AMD64=13457d54f6d190d38ae23e0a3c206d20b97a855cfa88d9081b90aec316c1af99
ANUBIS_TARBALL_SHA256_LINUX_AMD64=092f92b1710ee2eb208f019733f6ce06cbc041884272340bea13635a4515c357
ANUBIS_SIGNING_KEY_FPR=833F64161167B501058C394756375DA2DF02ABFF
